#!/bin/bash
set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo "Syncing dotfiles from $DOTFILES_ROOT..."

# Link AGENTS.md for Claude Code
ln -sf "$DOTFILES_ROOT/AGENTS.md" "$HOME/.claude_agent_instructions.md"
echo "  -> ~/.claude_agent_instructions.md"

# Link all files from files/home/ to ~/
find "$DOTFILES_ROOT/files/home" -type f | while read -r src; do
  rel_path="${src#$DOTFILES_ROOT/files/home/}"
  dest="$HOME/$rel_path"
  mkdir -p "$(dirname "$dest")"
  ln -sf "$src" "$dest"
  echo "  -> ~/$rel_path"
done

echo "Done."
